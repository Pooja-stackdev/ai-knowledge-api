APP_NAME=AI Knowledge API
ENVIRONMENT=development
DEBUG=false


DOCUMENT_STORAGE_PATH=storage/documents
DATABASE_URL=
TEST_DATABASE_URL=

GROQ_API_KEY=
GROQ_MODEL=

JWT_SECRET_KEY=replace-this-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email notifications (disabled by default; no email is sent until enabled)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_SENDER_ADDRESS=no-reply@example.com
EMAIL_SENDER_NAME=AI Knowledge API
FRONTEND_DOCUMENT_URL=
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_SENDING_TIMEOUT_MINUTES=15

FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password